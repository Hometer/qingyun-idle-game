# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，不会进仓库）
MODEL_API_KEY=
MODEL_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=4
ACCESS_CODE=
RATE_LIMIT_PER_MINUTE=20
# development=本地验收（空访问码放行）；production=公网（空访问码一律拒绝）
ENVIRONMENT=development
# 月度费用熔断（元），0 或负数 = 不启用
MONTHLY_BUDGET_RMB=100
# 模型标价（元/百万 token），上线前按厂商实际标价核对
MODEL_INPUT_PRICE_PER_MTOK=2
MODEL_OUTPUT_PRICE_PER_MTOK=8
